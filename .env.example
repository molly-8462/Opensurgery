SITE_NAME=OpenSurgery
DATABASE_URL=postgresql+psycopg://opensurgery:opensurgery@localhost:5432/opensurgery
POSTGRES_PASSWORD=replace-with-a-database-password
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
COOKIE_SECURE=false
MEDIA_ROOT=./var/media
APP_PORT=8000
SEED_DEMO_DATA=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_replace_with_your_resend_api_key
SMTP_FROM_ADDRESS="OpenSurgery <no-reply@your-verified-domain.example>"
SMTP_STARTTLS=true
SMTP_USE_SSL=false
